<?xml version="1.0" encoding="UTF-8"?>
<!-- Für www.labsupport.at (IIS über Plesk). Kommt nur mit dem Live-Build von build.mjs nach dist/.
     In XML-Kommentaren keine zwei Bindestriche hintereinander: IIS liefert sonst nur Fehler 500.
     Bewusst ohne <rewrite>: fehlt das URL-Rewrite-Modul, liefert IIS sonst für jede Seite Fehler 500.
     Die Umleitung auf HTTPS ist in Plesk eingestellt (Hosting-Einstellungen). -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Schriften: ältere IIS kennen woff2 nicht und liefern sonst 404 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
