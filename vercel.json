{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/luft-gase.html",
      "destination": "/gasgeneratoren.html",
      "permanent": false
    }
  ]
}
